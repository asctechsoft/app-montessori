{
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2022",
    "lib": [
      "es2022"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "rootDir": "..",
    "outDir": "../functions/.seed-build",
    "baseUrl": ".",
    "paths": {
      "firebase-admin/app": [
        "../functions/node_modules/firebase-admin/lib/app/index.d.ts"
      ],
      "firebase-admin/firestore": [
        "../functions/node_modules/firebase-admin/lib/firestore/index.d.ts"
      ],
      "firebase-admin/auth": [
        "../functions/node_modules/firebase-admin/lib/auth/index.d.ts"
      ]
    },
    "types": [
      "node"
    ],
    "typeRoots": [
      "../functions/node_modules/@types"
    ]
  },
  "files": [
    "seed.ts"
  ]
}
