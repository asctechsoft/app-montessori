{
  "name": "montessori-functions",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "test": "node --test lib/__tests__",
    "lint": "tsc --noEmit",
    "seed": "tsc -p ../scripts/tsconfig.json && node .seed-build/scripts/seed.js",
